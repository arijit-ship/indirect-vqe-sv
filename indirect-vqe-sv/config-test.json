{
  "output": {
    "output_dir": "../results/test_1",
    "output_prefix": "my-super-good-text-vqe-experiments",
    "verbosity": 3,
    "draw_circut_layer":{
      "enabled": true,
      "type": "png",
      "dpi": 300
    },
    "export_circuit_json": true,
    "expot_quantum_states":{
      "initial": true,
      "final": true
    }
  },
  "target_observable": {
    "type": "TFIH",
    "coefficients": {
      "j": 1.0,
      "h": 1.0
    }
  },
  "system": {
    "n_qubits": 5,
    "n_layers": 2,
    "drift": "XY",
    "time_evolution": {
      "total_time": 20,
      "totter_subdivide": {
        "enabled": true,
        "step_length": 0.1
      }
    }
  },
  "noise": {
    "drift_noise":{
      "enabled": false,
      "type": "Depolarizing",
      "strength": 0.001
      },
    "control_unit_noise": {
      "enabled": false,
      "type": "Depolarizing",
      "probability": 0.001
    },
    "cz_gate_noise": {
      "enabled": false,
      "type": "Depolarizing",
      "probability": 0.001
    }
  },
  "parameters": {
    "random_initialization": {
      "enabled": true,
      "seed": 512
    },
    "values": null,
    "constraints":{
      "monotonically_increasing_time": true,
      "fixed_final_time": false
      }
  },
  "optimization": {
    "method": "SLSQP",
      "options": {
      "maxiter": 1000,
      "disp": false,
      "eps": 1e-8,
      "ftol": 1e-6
    }
  }
}